<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form
      action="/admin/signup"
      method="POST"
      onsubmit="return validateSignUpForm();"
    >
      <div class="signup-frame">
        <!-- Header -->
        <div class="signup-top">
          <a href="/admin">TECHFORGE</a>
          <h2>Create Admin Account</h2>
          <p>Set up your administrator access.</p>
        </div>

        <!-- Username -->
        <div class="sign-up-frame">
          <label for="memberNick">Username *</label>

          <input
            type="text"
            id="memberNick"
            name="memberNick"
            class="member-nick"
            placeholder="Enter username"
            autocomplete="username"
            required
          />
        </div>

        <!-- Email -->
        <div class="sign-up-frame">
          <label for="memberEmail">Email *</label>

          <input
            type="email"
            id="memberEmail"
            name="memberEmail"
            class="member-email"
            placeholder="Enter email address"
            autocomplete="email"
            required
          />
        </div>

        <!-- Phone -->
        <div class="sign-up-frame">
          <label for="memberPhone">Phone *</label>

          <input
            type="tel"
            id="memberPhone"
            name="memberPhone"
            class="member-phone"
            placeholder="Enter phone number"
            autocomplete="tel"
            required
          />
        </div>

        <!-- Passwords -->
        <div class="signup-password-row">
          <div class="sign-up-frame">
            <label for="memberPassword">Password *</label>

            <input
              type="password"
              id="memberPassword"
              name="memberPassword"
              class="member-password"
              placeholder="Create password"
              autocomplete="new-password"
              required
            />
          </div>

          <div class="sign-up-frame">
            <label for="confirmPassword">Repeat Password *</label>

            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              autocomplete="new-password"
              required
            />

            <small id="password-message"></small>
          </div>
        </div>

        <!-- Admin type -->
        <input type="hidden" name="memberType" value="STORE" />

        <!-- Submit -->
        <button class="signup-btn" name="signup" type="submit">
          CREATE ADMIN ACCOUNT
        </button>

        <!-- Login -->
        <div class="signup-login">
          Already have an account?
          <a href="/admin/login">Login</a>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
