<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="home-container">
    <div class="navigation-menu">
      <div class="anim-container">
        <div class="anim">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 200">
            <defs>
              <pattern
                id="techforgePattern"
                patternUnits="userSpaceOnUse"
                width="1000"
                height="200"
              ></pattern>
            </defs>

            <text x="50" y="150" font-size="120" fill="url(#techforgePattern)">
              TECHFORGE
            </text>
          </svg>
        </div> 
      </div>
      <div class="nav-butt">
        <div>
          <button
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin'"
          >
            Home
          </button>
        </div>
        <div>
          <% if(!member) { %>
          <button
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin/signup'"
          >
            Sign up
          </button>
        </div>
        <div>
          <button
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin/login'"
          >
            Login
          </button>
           <% } else { %>
        </div>
        <div>
          <button
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin/product/all'"
          >
            Menu
          </button>
        </div>
        <div>
          <button
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin/product/all'"
          >
            Users
          </button>
        </div>
        <div>
          <button
            type="button"
            class="btn btn-lg nav-btn"
            onclick="window.location.href = '/admin/logout'"
          >
            Logout
          </button>
          <% } %>
        </div>
      </div>
    </div>
    <div class="body-container">
      <div class="left"></div>
      <div class="right">
        <span class="store-label"> WHAT'S NEW? </span>

        <h1>
          Power your<br />
          <span>next setup.</span>
        </h1>

        <p>
          Discover the latest laptops, GPUs, PCs and accessories built for
          performance.
        </p>

        <button class="store-button" onclick="window.location.href = '/'">Store ></button>
      </div>
    </div>
    <div class="statistics"></div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
</body>

<%- include('includes/footer') %>
