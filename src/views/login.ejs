    <form action="/admin/login" method="POST">
      <div class="login-frame">
        <!-- Header -->
        <div class="login-top">
          <span class="login-label"><a href="/admin">TECHFORGE</a></span>
          <h2>Admin Login</h2>
        </div>

        <!-- Username -->
        <div class="log-in-frame">
          <label for="memberNick">Store *</label>

          <input
            type="text"
            id="memberNick"
            name="memberNick"
            class="member-nick"
            placeholder="Enter username"
            autocomplete="username"
            required
          />
        </div>

        <!-- Passwords -->
        <div class="log-in-frame">
          <label for="memberPassword">Password *</label>

          <input
            type="password"
            id="memberPassword"
            name="memberPassword"
            class="member-password"
            placeholder="Create password"
            autocomplete="new-password"
            required
          />
        </div>

        <input type="hidden" name="memberType" value="STORE" />

        <button class="login-btn" name="login" type="submit">LOGIN</button>

        <!-- Login -->
        <div class="login-signup">
          New User?
          <a href="/admin/signup">Create Admin Account</a>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
