<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/products.css" />

  <body>

    <div class="products-container">
    <%- include('includes/nav') %>

      <div class="restaurant-menu-frame">
        <div class="board">
          <div class="dishes-table">
            <span class="new-dish-txt" style="margin-bottom: 30px">
              PRODUCT LIST
            </span>
            <table class="table table-bordered table-hover">
              <thead class="thead-light">
                <tr class="thead-light">
                  <th scope="col">T/r</th>
                  <th scope="col">Product Name</th>
                  <th scope="col">Product Brand</th>
                  <th scope="col">Product Category</th>
                  <th scope="col">Product Price</th>
                  <th scope="col">Product Stock</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>

              <!--  LOOP PRODUCTS: START  -->
              <tbody style="background: white">
                <% products.map(function(value, key) { %>
                  <tr>
                    <td>
                      <%= key + 1 %>
                    </td>
                    <td>
                      <%= value.productName %>
                    </td>
                    <td>
                      <%= value.productBrand %>
                    </td>
                    <td>
                      <%= value.productCategory %>
                    </td>
                    <td>
                      <input type="number" class="spec-select edit-field product-price" data-id="<%= value._id %>"
                        data-field="productPrice" value="<%= value.productPrice %>" style="width: 80px" />
                    </td>
                    <td>
                      <input type="number" class="spec-select edit-field product-left-count" data-id="<%= value._id %>"
                        data-field="productLeftCount" value="<%= value.productStock %>" style="width: 80px " />
                    </td>
                    <td>
                      <select class="spec-select new-product-status" data-id="<%= value._id %>">
                        <option value="PAUSE" <%=value.productStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
                        <option value="PROCESS" <%=value.productStatus==='PROCESS' ? 'selected' : '' %>>PROCESS</option>
                        <option value="DELETE" <%=value.productStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
                      </select>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
              <!--  LOOP PRODUCTS: END  -->
            </table>
            <div class="long-input" style="align-items: flex-end; margin-bottom: 25px">
              <button class="btn btn-primary" id="process-btn" onclick="window.location.href = '/admin/product/newProduct'">
                New Product
              </button>
            </div>
          </div>
          
        </div>
      </div>
    </div>

    <script type="text/javascript" src="/js/products.js"></script>
  </body>

  <%- include('includes/footer') %>