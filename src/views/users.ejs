<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>

  <div class="users-container">

    <%- include('includes/nav') %>

    <div class="users-frame">

      <div class="board">

        <div class="user-table">

          <span class="header-name" style="margin-bottom: 30px">
            All Users List
          </span>

          <table class="table table-hover table-sm">

            <thead class="thead-light">
              <tr>
                <th scope="col">No</th>
                <th scope="col">Name</th>
                <th scope="col">Phone</th>
                <th scope="col">Email</th>
                <th scope="col">Status</th>
              </tr>
            </thead>

            <tbody>

              <% if (users && users.length > 0) { %>

                <% users.forEach((user, index) => { %>

                  <tr>

                    <td>
                      <%= index + 1 %>
                    </td>

                    <td>
                      <%= user.memberNick %>
                    </td>

                    <td>
                      <%= user.memberPhone || "—" %>
                    </td>

                    <td>
                      <%= user.memberEmail || "—" %>
                    </td>

                    <td style="width: 13%">

                      <select
                        class="spec-select member-status"
                        data-id="<%= user._id %>"
                      >

                        <option
                          value="ACTIVE"
                          <%= user.memberStatus === "ACTIVE" ? "selected" : "" %>
                        >
                          ACTIVE
                        </option>

                        <option
                          value="BLOCK"
                          <%= user.memberStatus === "BLOCK" ? "selected" : "" %>
                        >
                          BLOCK
                        </option>

                        <option
                          value="DELETE"
                          <%= user.memberStatus === "DELETE" ? "selected" : "" %>
                        >
                          DELETE
                        </option>

                      </select>

                    </td>

                  </tr>

                <% }) %>

              <% } else { %>

                <tr>

                  <td
                    colspan="5"
                    style="text-align: center; padding: 40px;"
                  >
                    No users found
                  </td>

                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

  <script
    type="text/javascript"
    src="/js/users.js"
  ></script>

</body>

<%- include('includes/footer') %>